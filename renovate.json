{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* * * * 5"],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "automerge": true,
  "platformAutomerge": true,
  "configMigration": true,
  "packageRules": [
    {
      "description": "Major updates need a human review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "gitIgnoredAuthors": [
    "346494549+container-tools-automation[bot]@users.noreply.github.com"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "bats-core release in hack/install-bats.sh; BATS_SHA256 follows via hack/update-checksums.sh",
      "managerFilePatterns": [
        "/^hack/install-bats\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+BATS_VERSION=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
