{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* * * * 5"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "automerge": true,
  "platformAutomerge": true,
  "configMigration": true,
  "packageRules": [
    {
      "description": "Major updates need a human review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in hack/build-sysroot.sh: a renovate comment, the version on the next line and optionally its sha256 or commit as digest on the line after",
      "managerFilePatterns": [
        "/^hack/build-sysroot\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*[\\w-]+[:=] ?(?<currentValue>\\S+)(?:\\n\\s*[\\w-]+[:=] ?(?<currentDigest>[0-9a-f]{40,64}))?"
      ]
    }
  ]
}
